# /etc/ttrpg-scheduling.env (mode 0640, owner root:ttrpg) — read by both systemd units.
DATABASE_URL=sqlite:/var/lib/ttrpg-scheduling/app.db
# The Pi's VPN address (e.g. its Tailscale 100.x.y.z), so the app is unreachable from the LAN.
BIND_ADDR=100.64.0.1:8080
DISPLAY_TZ=Europe/Prague
RUST_LOG=info
